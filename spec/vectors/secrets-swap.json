{
  "$comment": "Appendix C §2 — Secrets swap (Part 04 §3). Conformance: L3. Resolver stubbed: source name -> resolved value. Each case gives the secret's config, the input request slice, and the expected output. Headers are ordered [name, value] pairs; expected headers are byte-for-byte. 'verdict' is the secrets transform's verdict for the request.",
  "resolver": { "OPENAI_API_KEY": "sk-real" },
  "cases": [
    {
      "id": 1,
      "secret": {
        "source": { "type": "env", "var": "OPENAI_API_KEY" },
        "proxy_value": "proxy-tok",
        "match_headers": ["Authorization"],
        "require": false,
        "rules": [{ "host": "api.example.com" }]
      },
      "request": {
        "host": "api.example.com", "method": "GET", "path": "/", "query": "",
        "headers": [["Authorization", "Bearer proxy-tok"]], "body": ""
      },
      "expect": {
        "verdict": "continue",
        "headers": [["Authorization", "Bearer sk-real"]],
        "annotations": { "swapped": [{ "secret": "OPENAI_API_KEY", "locations": ["header:Authorization"] }] }
      }
    },
    {
      "id": 2,
      "$comment": "Basic credentials proxy-tok:x are base64-decoded, swapped, re-encoded",
      "secret": {
        "source": { "type": "env", "var": "OPENAI_API_KEY" },
        "proxy_value": "proxy-tok",
        "match_headers": ["Authorization"],
        "require": false,
        "rules": [{ "host": "api.example.com" }]
      },
      "request": {
        "host": "api.example.com", "method": "GET", "path": "/", "query": "",
        "headers": [["Authorization", "Basic cHJveHktdG9rOng="]], "body": ""
      },
      "expect": {
        "verdict": "continue",
        "headers": [["Authorization", "Basic c2stcmVhbDp4"]],
        "annotations": { "swapped": [{ "secret": "OPENAI_API_KEY", "locations": ["header:Authorization"] }] }
      }
    },
    {
      "id": 3,
      "$comment": "match_headers: [] scans all headers; every occurrence swapped",
      "secret": {
        "source": { "type": "env", "var": "OPENAI_API_KEY" },
        "proxy_value": "proxy-tok",
        "match_headers": [],
        "require": false,
        "rules": [{ "host": "api.example.com" }]
      },
      "request": {
        "host": "api.example.com", "method": "GET", "path": "/", "query": "",
        "headers": [["X-A", "proxy-tok"], ["X-B", "say-proxy-tok-twice-proxy-tok"]], "body": ""
      },
      "expect": {
        "verdict": "continue",
        "headers": [["X-A", "sk-real"], ["X-B", "say-sk-real-twice-sk-real"]],
        "annotations": { "swapped": [{ "secret": "OPENAI_API_KEY", "locations": ["header:X-A", "header:X-B"] }] }
      }
    },
    {
      "id": 4,
      "secret": {
        "source": { "type": "env", "var": "OPENAI_API_KEY" },
        "proxy_value": "proxy-tok",
        "match_headers": ["Authorization"],
        "match_query": true,
        "require": false,
        "rules": [{ "host": "api.example.com" }]
      },
      "request": {
        "host": "api.example.com", "method": "GET", "path": "/", "query": "token=proxy-tok&q=hi",
        "headers": [], "body": ""
      },
      "expect": {
        "verdict": "continue",
        "query": "token=sk-real&q=hi",
        "annotations": { "swapped": [{ "secret": "OPENAI_API_KEY", "locations": ["query"] }] }
      }
    },
    {
      "id": 5,
      "secret": {
        "source": { "type": "env", "var": "OPENAI_API_KEY" },
        "proxy_value": "proxy-tok",
        "match_headers": ["Authorization"],
        "match_path": true,
        "require": false,
        "rules": [{ "host": "api.example.com" }]
      },
      "request": {
        "host": "api.example.com", "method": "POST", "path": "/botproxy-tok/send", "query": "",
        "headers": [], "body": ""
      },
      "expect": {
        "verdict": "continue",
        "path": "/botsk-real/send",
        "annotations": { "swapped": [{ "secret": "OPENAI_API_KEY", "locations": ["path"] }] }
      }
    },
    {
      "id": 6,
      "$comment": "body swap forces buffering; Content-Length recomputed by the forwarder from the buffered bytes",
      "secret": {
        "source": { "type": "env", "var": "OPENAI_API_KEY" },
        "proxy_value": "proxy-tok",
        "match_headers": ["Authorization"],
        "match_body": true,
        "require": false,
        "rules": [{ "host": "api.example.com" }]
      },
      "request": {
        "host": "api.example.com", "method": "POST", "path": "/", "query": "",
        "headers": [["Content-Type", "application/json"]], "body": "{\"key\":\"proxy-tok\"}"
      },
      "expect": {
        "verdict": "continue",
        "body": "{\"key\":\"sk-real\"}",
        "annotations": { "swapped": [{ "secret": "OPENAI_API_KEY", "locations": ["body"] }] }
      }
    },
    {
      "id": 7,
      "$comment": "require: true and token absent -> Reject",
      "secret": {
        "source": { "type": "env", "var": "OPENAI_API_KEY" },
        "proxy_value": "proxy-tok",
        "match_headers": ["Authorization"],
        "require": true,
        "rules": [{ "host": "api.example.com" }]
      },
      "request": {
        "host": "api.example.com", "method": "GET", "path": "/", "query": "",
        "headers": [["Authorization", "Bearer something-else"]], "body": ""
      },
      "expect": {
        "verdict": "reject",
        "annotations": {}
      }
    },
    {
      "id": 8,
      "$comment": "require: false and resolver failure -> Continue, unavailability annotated, no value anywhere",
      "resolver_fails": true,
      "secret": {
        "source": { "type": "env", "var": "OPENAI_API_KEY" },
        "proxy_value": "proxy-tok",
        "match_headers": ["Authorization"],
        "require": false,
        "rules": [{ "host": "api.example.com" }]
      },
      "request": {
        "host": "api.example.com", "method": "GET", "path": "/", "query": "",
        "headers": [["Authorization", "Bearer proxy-tok"]], "body": ""
      },
      "expect": {
        "verdict": "continue",
        "headers": [["Authorization", "Bearer proxy-tok"]],
        "annotations": { "secret_unavailable": ["OPENAI_API_KEY"] }
      }
    }
  ]
}
